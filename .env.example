PORT=8000

# E-mail via SMTP. Sem estas variáveis, o relatório é gerado e baixado,
# mas o envio por e-mail fica marcado como não configurado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# WhatsApp Business Cloud API da Meta.
# WHATSAPP_API_VERSION deve ser uma versão Graph API habilitada na sua conta.
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
